---
---
<section id="szolgaltatasok" class="scroll-mt-20 pt-8 pb-16 px-[5%] max-w-[1300px] mx-auto">
    <div class="text-center mb-16 reveal">
        <div class="inline-flex items-center gap-2 bg-[#0072FF]/10 border border-[#0072FF]/30 text-[#00C6FF] px-4 py-1.5 rounded-full text-xs font-semibold mb-4 tracking-wide">
            ✨ PRÉMIUM SZOLGÁLTATÁSOK
        </div>
        <h2 class="text-4xl md:text-5xl font-extrabold mb-4">Miben tudunk segítani?</h2>
        <p class="text-gray-400 max-w-xl mx-auto">Nem csak weboldalakat építünk — jövőálló digitális platformokat hozunk létre.</p>
    </div>

    <!-- BENTO GRID CONTAINER -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- CARD 1 -->
        <div class="md:col-span-2 bg-gradient-to-br from-gray-900/80 to-gray-900/30 border border-white/10 rounded-3xl p-8 hover:border-[#0072FF]/50 transition-all duration-300 relative overflow-hidden group reveal-flip">
            <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-[#0072FF]/10 rounded-full blur-3xl group-hover:bg-[#0072FF]/20 transition-all"></div>
            
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-8">
                <div>
                    <span class="text-xs font-mono text-[#00C6FF] uppercase tracking-wider">01 // ARCHITEKTÚRA</span>
                    <h3 class="text-2xl font-bold mt-1">Villámgyors Weboldalak & Appok</h3>
                </div>
                <div class="flex items-center gap-3 bg-[#090d16] border border-emerald-500/30 px-4 py-2 rounded-2xl shadow-lg">
                    <div class="w-10 h-10 rounded-full border-2 border-emerald-500 flex items-center justify-center font-bold text-emerald-400 text-sm">
                        100
                    </div>
                    <div class="text-xs">
                        <div class="font-bold text-white">Google Lighthouse</div>
                        <div class="text-emerald-400">Perfekt Teljesítmény</div>
                    </div>
                </div>
            </div>

            <p class="text-gray-400 text-sm leading-relaxed max-w-xl mb-6">
                Astro 5 és Tailwind CSS alapú fejlesztés. Minimális JavaScript, maximális sebesség és azonnali betöltés minden eszközön.
            </p>

            <div class="flex flex-wrap gap-2 pt-4 border-t border-white/5">
                <span class="bg-white/5 border border-white/10 text-xs text-gray-300 px-3 py-1.5 rounded-lg font-mono">⚡ Astro 5</span>
                <span class="bg-white/5 border border-white/10 text-xs text-gray-300 px-3 py-1.5 rounded-lg font-mono">🎨 Tailwind CSS</span>
                <span class="bg-white/5 border border-white/10 text-xs text-gray-300 px-3 py-1.5 rounded-lg font-mono">🚀 Cloudflare Edge</span>
                <span class="bg-white/5 border border-white/10 text-xs text-gray-300 px-3 py-1.5 rounded-lg font-mono">📘 TypeScript</span>
            </div>
        </div>

        <!-- CARD 2 -->
        <div class="bg-gradient-to-br from-gray-900/80 to-gray-900/30 border border-white/10 rounded-3xl p-8 hover:border-[#0072FF]/50 transition-all duration-300 relative overflow-hidden group reveal-flip" style="transition-delay: 150ms;">
            <div class="w-12 h-12 bg-[#0072FF]/10 rounded-2xl flex items-center justify-center mb-6 text-[#00C6FF] group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            </div>
            <span class="text-xs font-mono text-[#00C6FF] uppercase tracking-wider">02 // E-COMMERCE</span>
            <h3 class="text-xl font-bold mt-1 mb-3">Modern Webáruházak</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
                Nagy konverziójú, letisztult webshopok integrált fizetéssel és automatizált számlázással.
            </p>
            <div class="bg-[#090d16]/80 p-3 rounded-xl border border-white/5 flex items-center justify-between text-xs">
                <span class="text-gray-400">Konverziós növekedés</span>
                <span class="text-emerald-400 font-bold">+35%</span>
            </div>
        </div>

        <!-- CARD 3 -->
        <div class="bg-gradient-to-br from-gray-900/80 to-gray-900/30 border border-white/10 rounded-3xl p-8 hover:border-[#0072FF]/50 transition-all duration-300 relative overflow-hidden group reveal-flip" style="transition-delay: 250ms;">
            <div class="w-12 h-12 bg-[#0072FF]/10 rounded-2xl flex items-center justify-center mb-6 text-[#00C6FF] group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            </div>
            <span class="text-xs font-mono text-[#00C6FF] uppercase tracking-wider">03 // DESIGN</span>
            <h3 class="text-xl font-bold mt-1 mb-3">UI/UX Tervezés</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
                Figma prototípusok, sötét/világos témák és reszponzív felületek, melyek azonnal megfogják a látogatót.
            </p>
        </div>

        <!-- CARD 4 -->
        <div class="md:col-span-2 bg-gradient-to-br from-gray-900/80 to-gray-900/30 border border-white/10 rounded-3xl p-8 hover:border-[#0072FF]/50 transition-all duration-300 relative overflow-hidden group reveal-flip" style="transition-delay: 350ms;">
            <div class="grid md:grid-cols-2 gap-6 items-center">
                <div>
                    <span class="text-xs font-mono text-[#00C6FF] uppercase tracking-wider">04 // SEO & OPTIMIZÁCIÓ</span>
                    <h3 class="text-2xl font-bold mt-1 mb-3">Keresőoptimatizálás & SSL</h3>
                    <p class="text-gray-400 text-sm leading-relaxed mb-4">
                        A Google imádja a gyors oldalakat. Strukturált adatokkal, sitemap generálással és Cloudflare SSL védelemmel építjük az oldalad.
                    </p>
                </div>

                <div class="bg-[#090d16] p-5 rounded-2xl border border-white/10 space-y-3">
                    <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-white/5">
                        <span class="text-gray-300">Automata SSL Titkosítás</span>
                        <span class="w-3 h-3 bg-emerald-400 rounded-full animate-ping"></span>
                    </div>
                    <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-white/5">
                        <span class="text-gray-300">Google Indexelés (Sitemap)</span>
                        <span class="text-emerald-400 font-semibold">Aktív ✓</span>
                    </div>
                    <div class="flex items-center justify-between text-xs p-2 rounded-lg bg-white/5">
                        <span class="text-gray-300">DDoS Elleni Védelem</span>
                        <span class="text-emerald-400 font-semibold">Aktív ✓</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>