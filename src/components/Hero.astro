---
<section class="pt-32 pb-10 px-[5%] max-w-[1300px] mx-auto grid md:grid-cols-2 gap-12 items-center">
    <div class="reveal">
        <div class="inline-flex items-center gap-2 bg-[#0072FF]/10 border border-[#0072FF]/30 text-[#00C6FF] px-4 py-1.5 rounded-full text-xs font-semibold mb-6 tracking-wide">
            <span>⚡</span> CLOUDFLARE POWERED & ULTRA FAST
        </div>
        <h1 class="text-5xl lg:text-6xl font-extrabold leading-tight mb-6">
            Digitális élmények, melyek <span class="bg-gradient-to-r from-[#0072FF] to-[#00C6FF] bg-clip-text text-transparent">eredményeket</span> hoznak.
        </h1>
        <p class="text-gray-400 text-lg mb-8 max-w-[540px]">
            Egyedi, szélsebes és modern weboldalak, e-kereskedelmi rendszerek és webalkalmazások fejlesztése Astro & Tailwind technológiával.
        </p>
        <div class="flex gap-4">
            <a href="#kapcsolat" class="bg-gradient-to-r from-[#0072FF] to-[#00C6FF] text-white px-7 py-3 rounded-lg font-semibold hover:shadow-[0_0_25px_rgba(0,114,255,0.4)] hover:-translate-y-0.5 transition-all">Projekt indítása</a>
            <a href="#szolgaltatasok" class="bg-white/5 border border-white/10 text-white px-7 py-3 rounded-lg font-semibold hover:bg-white/10 transition-all">Szolgáltatások</a>
        </div>
    </div>

    <!-- ANIMÁLT KÓD ABLAK -->
    <div class="bg-[#0d1322] border border-white/10 rounded-2xl overflow-hidden shadow-2xl animate-float reveal" style="transition-delay: 200ms;">
        <div class="bg-[#070a12] px-4 py-3 flex items-center gap-2 border-b border-white/10">
            <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
            <span class="ml-2 text-xs font-mono text-gray-400">AzariusDev.config.ts</span>
        </div>
        <div class="p-6 font-mono text-sm text-gray-300 leading-relaxed">
            <p class="text-gray-500">// Cloudflare Pages kompatibilis architektúra</p>
            <p><span class="text-pink-400">export const</span> <span class="text-blue-400">azariusDev</span> = &#123;</p>
            <p class="pl-4">speed: <span class="text-emerald-400">"100/100 Lighthouse"</span>,</p>
            <p class="pl-4">stack: [<span class="text-emerald-400">"Astro"</span>, <span class="text-emerald-400">"Tailwind"</span>, <span class="text-emerald-400">"Cloudflare"</span>],</p>
            <p class="pl-4">seoOptimized: <span class="text-pink-400">true</span>,</p>
            <p class="pl-4">impact: () =&gt; <span class="text-blue-400">"High Conversion & Growth"</span></p>
            <p>&#125;;</p>
        </div>
    </div>
</section>